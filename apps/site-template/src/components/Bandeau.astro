---
import { t } from '../content/ui';

interface Props {
  entreprise: string;
}
const { entreprise } = Astro.props;

/*
 * Le bandeau de démonstration.
 *
 * Il n'est PAS pilotable par le fichier de contenu, et c'est tout son intérêt.
 * Le site porte le nom d'une entreprise réelle et est publié sans son accord
 * (D5, §11 conformité) : s'il pouvait s'éteindre par une clé JSON, une
 * génération malheureuse — ou une main humaine dans le dépôt du prospect —
 * produirait une page qui se ferait passer pour le site officiel de
 * l'artisan.
 *
 * Il est volontairement discret plutôt qu'alarmant. L'argumentaire de vente
 * est « voici à quoi ressemblerait votre site » : un bandeau rouge le
 * détruirait, une absence de bandeau serait malhonnête.
 */
---

<aside class="bandeau" aria-label={t('demo.aria')}>
  <p class="texte">{t('demo.banner', { entreprise })}</p>
</aside>

<style>
  .bandeau {
    background: var(--encre);
    color: #fff;
    padding-block: 0.6rem;
  }
  .texte {
    width: min(var(--largeur), 100% - 2.5rem);
    margin-inline: auto;
    font-size: 0.82rem;
    line-height: 1.45;
    opacity: 0.92;
  }
</style>
