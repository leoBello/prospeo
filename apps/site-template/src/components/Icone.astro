---
/*
 * Les icônes, dessinées à la main plutôt qu'importées.
 *
 * Une police d'icônes ou un paquet npm ajouterait une dépendance — donc une
 * requête, ou du poids — pour douze tracés qui tiennent dans ce fichier. Elles
 * sont en trait, jamais en aplat : le parti « Atelier » repose sur des filets
 * fins, et une icône pleine y ferait tache.
 *
 * Toutes sont `aria-hidden` : elles doublent un texte qui est toujours
 * présent à côté. Une icône annoncée par un lecteur d'écran en plus de son
 * libellé fait entendre la même chose deux fois.
 */
export type NomIcone =
  | 'telephone'
  | 'lieu'
  | 'horloge'
  | 'etoile'
  | 'goutte'
  | 'ballon'
  | 'vasque'
  | 'douche'
  | 'radiateur'
  | 'tuyau'
  | 'cle';

interface Props {
  nom: NomIcone;
  classe?: string;
}
const { nom, classe = 'icone' } = Astro.props;

const TRACES: Record<NomIcone, string> = {
  telephone:
    'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z',
  lieu: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  horloge: 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z M12 7v5l3 2',
  etoile: 'm12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1L12 2Z',
  // Une goutte pour le dépannage : c'est la fuite qui fait décrocher le
  // téléphone, et c'est le seul dessin que tout le monde lit sans légende.
  goutte: 'M12 22a7 7 0 0 0 7-7c0-4.5-7-13-7-13S5 10.5 5 15a7 7 0 0 0 7 7Z',
  ballon: 'M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z M9 8h6 M9 12h6 M12 17h.01',
  vasque: 'M4 12h16v3a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-3Z M8 12V6a2 2 0 0 1 4 0v1 M4 12h16',
  douche: 'M3 21V9a4 4 0 0 1 8 0 M11 5h10 M15 9h.01 M18 12h.01 M15 15h.01 M19 16h.01',
  radiateur: 'M7 4v16 M12 4v16 M17 4v16 M4 7h16 M4 17h16',
  tuyau: 'M4 8h6a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h6 M4 5v6 M20 13v6',
  cle: 'M15 7a4 4 0 1 1-3.9 5H8v3H5v-3H2v-3h9.1A4 4 0 0 1 15 7Z',
};

const traces = (TRACES[nom] ?? '').split(' M').map((d, i) => (i === 0 ? d : `M${d}`));
---

<svg class={classe} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {traces.map((d) => <path d={d} />)}
</svg>
