# Prospeo — variables d'environnement.
# Copier ce fichier en `.env` et renseigner les valeurs.
# `.env` est ignore par git : n'y mettez jamais de secret dans un fichier suivi.

# ---------------------------------------------------------------------------
# Supabase — Dashboard > Project Settings > API
# ---------------------------------------------------------------------------

# URL du projet ("Project URL"). Forme : https://<ref>.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Cle service_role ("Project API keys" > service_role, cliquer sur Reveal).
# ATTENTION : cette cle contourne les politiques RLS. Elle est reservee au
# collector qui tourne sur votre machine. Ne la mettez JAMAIS dans le front,
# ni dans une variable prefixee VITE_, qui partirait dans le bundle public.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Dashboard (plan n°2 — pas encore utilise)
# ---------------------------------------------------------------------------

# Cle anon ("Project API keys" > anon public). Publique par construction :
# elle part dans le bundle JavaScript. C'est RLS qui protege les donnees.
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=
