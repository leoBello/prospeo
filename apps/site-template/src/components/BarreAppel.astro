---
import type { SiteContent } from '@prospeo/core';
import { t } from '../content/ui';

interface Props {
  contenu: SiteContent;
}
const { faits } = Astro.props.contenu;

/*
 * La barre d'appel, fixée en bas de l'écran.
 *
 * C'est l'élément qui décide de l'utilité du site. Le client d'un plombier le
 * cherche sur un téléphone, souvent dans l'urgence, et ce qu'il veut n'est pas
 * de lire une page : c'est d'appeler. La barre rend l'appel atteignable au
 * pouce à n'importe quel endroit de la page.
 *
 * En CSS pur, sans une ligne de JavaScript (D2). `position: fixed` suffit ;
 * la réserve d'espace correspondante est prise dans les mentions légales, de
 * sorte que la barre ne recouvre jamais le bloc qui déclare la démonstration.
 *
 * Elle DISPARAÎT sur écran large. Une barre d'action collée en bas de fenêtre
 * est un idiome de téléphone : sur un écran de bureau, où le bouton du haut
 * de page reste à portée et où la page entière tient presque en une vue, elle
 * ne fait qu'amputer la fenêtre. Le seuil est celui des deux colonnes du
 * reste du gabarit, pour que tout bascule d'un coup.
 */
---

<div class="barre">
  <a
    class="bouton"
    href={`tel:${faits.telephone.e164}`}
    aria-label={t('cta.callAria', {
      nom: faits.nomAffiche,
      telephone: faits.telephone.affichage,
    })}
  >
    <span>{t('cta.call')}</span>
    <span class="numero">{faits.telephone.affichage}</span>
  </a>
</div>

<style>
  .barre {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding: 0.65rem 1rem;
    /* `env(safe-area-inset-bottom)` : sans lui, la barre passe sous
       l'indicateur d'accueil des iPhone récents et le bouton devient à moitié
       inatteignable — précisément sur l'appareil visé. */
    padding-bottom: calc(0.65rem + env(safe-area-inset-bottom, 0px));
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--trait);
  }
  .bouton {
    width: min(28rem, 100%);
  }
  .numero {
    font-variant-numeric: tabular-nums;
    opacity: 0.9;
  }
  @media (min-width: 40rem) {
    .barre {
      display: none;
    }
  }
</style>
